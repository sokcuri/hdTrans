#include <winver.h>

1 VERSIONINFO
FILEVERSION @HDTRANS_VERSION_NUMERIC@
PRODUCTVERSION @HDTRANS_VERSION_NUMERIC@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE @HDTRANS_RESOURCE_TYPE@
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "hdTrans\0"
            VALUE "FileVersion", "@HDTRANS_VERSION_TEXT@\0"
            VALUE "InternalName", "@HDTRANS_RESOURCE_FILENAME@\0"
            VALUE "LegalCopyright", "Copyright (c) Sokcuri (https://github.com/sokcuri). MPL-2.0\0"
            VALUE "OriginalFilename", "@HDTRANS_RESOURCE_FILENAME@\0"
            VALUE "ProductName", "hdTrans\0"
            VALUE "ProductVersion", "@HDTRANS_VERSION_TEXT@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
