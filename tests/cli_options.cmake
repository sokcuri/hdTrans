cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED CLI OR NOT DEFINED FIXTURE OR NOT DEFINED WORK)
    message(FATAL_ERROR "CLI, FIXTURE and WORK are required")
endif()
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 run)
set(root "${WORK}/${run}")
file(MAKE_DIRECTORY "${root}/home" "${root}/dicts" "${root}/ehnd")
file(COPY "${FIXTURE}/" DESTINATION "${root}/dicts")
file(WRITE "${root}/dicts/dicts.txt" "test-dictionary-1\n")

function(run_cli)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "HOME=${root}/home" "HDTRANS_CACHE_DIR=off"
        "${CLI}" --dicts "${root}/dicts" --userdict "" ${ARGN}
        RESULT_VARIABLE status OUTPUT_FILE "${root}/stdout" ERROR_VARIABLE error)
    file(READ "${root}/stdout" output)
    # Text reads normalize CRLF on Windows; HEX retains the output bytes.
    file(READ "${root}/stdout" outputHex HEX)
    set(status "${status}" PARENT_SCOPE)
    set(output "${output}" PARENT_SCOPE)
    set(outputHex "${outputHex}" PARENT_SCOPE)
    set(error "${error}" PARENT_SCOPE)
endfunction()

function(require_success)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "CLI failed (${status}): ${error}")
    endif()
endfunction()

run_cli(--help)
require_success()
if(NOT output MATCHES "^hdTrans v[^\n]+\nAuthor: Sokcuri" OR NOT output MATCHES "--out")
    message(FATAL_ERROR "help header or options missing: ${output}")
endif()
run_cli(--version)
require_success()
if(NOT output MATCHES "^hdTrans v[^\n]+ \\(native\\) / dict test-dictionary-1\n$")
    message(FATAL_ERROR "wrong version: ${output}")
endif()
run_cli(-version)
require_success()
run_cli(--version --dicts "${root}/missing")
if(status EQUAL 0)
    message(FATAL_ERROR "version must load the selected dictionary")
endif()

run_cli("学生です。")
require_success()
set(normal "${output}")
run_cli(--json "学生です。")
require_success()
string(JSON text GET "${output}" text)
string(JSON choices TYPE "${output}" choices)
string(JSON logs TYPE "${output}" logs)
if(NOT text STREQUAL normal OR NOT choices STREQUAL "ARRAY" OR NOT logs STREQUAL "ARRAY")
    message(FATAL_ERROR "JSON differs from plain translation: ${output}")
endif()
run_cli(-json "学生です。")
require_success()
string(JSON text GET "${output}" text)
if(NOT text STREQUAL normal)
    message(FATAL_ERROR "legacy JSON alias differs")
endif()

file(WRITE "${root}/input.txt" "学生です。\n東京です。\n")
run_cli(--in "${root}/input.txt")
require_success()
set(documentHex "${outputHex}")
run_cli(--file "${root}/input.txt")
require_success()
if(NOT outputHex STREQUAL documentHex)
    message(FATAL_ERROR "--file differs from --in")
endif()
run_cli("--in=${root}/input.txt" --json)
require_success()
string(JSON text GET "${output}" text)
string(HEX "${text}" textHex)
if(NOT textHex STREQUAL documentHex)
    message(FATAL_ERROR "multiline JSON differs: expected ${documentHex}, got ${textHex}")
endif()
run_cli(--in "${root}/input.txt" --out "${root}/output.txt")
require_success()
file(READ "${root}/output.txt" saved HEX)
if(NOT output STREQUAL "" OR NOT saved STREQUAL documentHex)
    message(FATAL_ERROR "--out must write only to its file")
endif()
run_cli(--file "${root}/input.txt" --json --out "${root}/output.json")
require_success()
file(READ "${root}/output.json" saved)
string(JSON text GET "${saved}" text)
string(HEX "${text}" textHex)
if(NOT output STREQUAL "" OR NOT textHex STREQUAL documentHex)
    message(FATAL_ERROR "JSON --out differs")
endif()
file(WRITE "${root}/same.txt" "学生です。")
run_cli(--in "${root}/same.txt" --out "${root}/same.txt")
require_success()
file(READ "${root}/same.txt" saved)
if(NOT saved STREQUAL normal)
    message(FATAL_ERROR "same input/output was truncated")
endif()
run_cli(--out "${root}/missing/output.txt" "学生です。")
if(status EQUAL 0)
    message(FATAL_ERROR "output write failure must fail")
endif()

file(WRITE "${root}/ehnd/PreFilter_test.txt" "学生\t東京\t100\t0\n")
file(WRITE "${root}/ehnd/PostFilter_test.txt" "^.+$\tFILTER-OK\t100\t1\n")
run_cli(--why --ehnd "${root}/ehnd" "学生です。")
require_success()
if(NOT output STREQUAL "FILTER-OK" OR NOT error MATCHES "PreFilter :" OR NOT error MATCHES "PostFIlter :")
    message(FATAL_ERROR "--why filter trace missing: ${error}")
endif()
run_cli(--ehnd "${root}/ehnd" "学生です。")
require_success()
if(NOT output STREQUAL "FILTER-OK" OR error MATCHES "PreFilter :|PostFIlter :|\\[REQUEST\\]")
    message(FATAL_ERROR "plain translation must not emit execution logs")
endif()
run_cli(--json --why --ehnd "${root}/ehnd" "学生です。")
require_success()
string(JSON text GET "${output}" text)
if(NOT text STREQUAL "FILTER-OK" OR NOT error MATCHES "PostFIlter :")
    message(FATAL_ERROR "JSON and --why must coexist")
endif()

run_cli(--json --each --in "${root}/input.txt")
require_success()
string(JSON count LENGTH "${output}" choices)
if(count LESS 2)
    message(FATAL_ERROR "--each trace missing")
endif()
run_cli(--json --raw --in "${root}/input.txt")
require_success()
string(JSON kind TYPE "${output}" choices)
run_cli(-- "--literal-input")
require_success()
foreach(flag IN ITEMS --unknown --in --json=true)
    run_cli("${flag}")
    if(NOT status EQUAL 2 OR NOT output STREQUAL "")
        message(FATAL_ERROR "invalid option must fail cleanly: ${flag}")
    endif()
endforeach()
run_cli(--in "${root}/input.txt" "学生です。")
if(NOT status EQUAL 2)
    message(FATAL_ERROR "mixed input sources must fail")
endif()
run_cli(--verify-dicts "学生です。")
require_success()
set(markerDicts "${CMAKE_CURRENT_LIST_DIR}/unit/dict/testdata/marker_class")
run_cli(--dicts "${markerDicts}" "高")
require_success()
run_cli(--dicts "${markerDicts}" --verify-dicts "高")
if(status EQUAL 0 OR NOT error MATCHES "base.tsv:7: the marker family &AV@ conjugates class 4 \\(verb\\) stems, not the part code N110\n"
   OR NOT error MATCHES "3 dictionary lines fail verification")
    message(FATAL_ERROR "verification must fail on marker families that do not fit the part code (${status}): ${error}")
endif()
file(MAKE_DIRECTORY "${root}/unrelated-cwd/dicts")
file(WRITE "${root}/unrelated-cwd/dicts/base.tsv" "key\tko\tpos\tid\n猫\t작업경로\tN110\t1\n")
get_filename_component(cliName "${CLI}" NAME)
function(run_discovered)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "HOME=${root}/home" "HDTRANS_CACHE_DIR=off"
        "${discoveredCli}" ${ARGN} WORKING_DIRECTORY "${root}/unrelated-cwd"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(status "${status}" PARENT_SCOPE)
    set(output "${output}" PARENT_SCOPE)
    set(error "${error}" PARENT_SCOPE)
endfunction()

foreach(layout IN ITEMS flat nested)
    set(program "${root}/standalone-${layout}")
    file(MAKE_DIRECTORY "${program}")
    file(COPY "${CLI}" DESTINATION "${program}")
    set(discoveredCli "${program}/${cliName}")
    if(NOT WIN32)
        file(RENAME "${discoveredCli}" "${program}/hdtrans-cli")
        set(discoveredCli "${program}/hdtrans-cli")
    endif()
    if(layout STREQUAL "nested")
        set(data "${program}/HDTRANS")
    else()
        set(data "${program}")
    endif()
    file(MAKE_DIRECTORY "${data}/DiCtS" "${data}/USER" "${program}/source-dicts")
    file(WRITE "${program}/source-dicts/base.tsv" "key\tko\tpos\tid\n猫\t고양이\tN110\t1\n")
    set(snapshot "${data}/DiCtS.HdSnAp")
    run_cli(--dicts "${program}/source-dicts" --compile-snapshot "${snapshot}")
    require_success()
    file(REMOVE_RECURSE "${program}/source-dicts")
    file(WRITE "${data}/dicts.txt" "standalone-dictionary\n")
    file(WRITE "${data}/DiCtS/base.tsv" "key\tko\tpos\tid\n猫\t야옹이\tN110\t1\n")
    file(WRITE "${data}/USER/USERDICT.TSV" "犬\t새사전\n")
    run_discovered("猫")
    require_success()
    if(NOT output STREQUAL "고양이")
        message(FATAL_ERROR "${layout} default must prefer snapshot over TSV and CWD: ${output}")
    endif()
    run_discovered("犬")
    require_success()
    if(NOT output STREQUAL "새사전")
        message(FATAL_ERROR "${layout} snapshot must keep independent user discovery: ${output}")
    endif()
    run_discovered(--version)
    require_success()
    if(NOT output MATCHES " / dict standalone-dictionary\n$")
        message(FATAL_ERROR "${layout} snapshot dictionary version missing: ${output}")
    endif()
    run_discovered(--dicts "${data}/DiCtS" "猫")
    require_success()
    if(NOT output STREQUAL "야옹이")
        message(FATAL_ERROR "explicit dictionary must override ${layout} default snapshot: ${output}")
    endif()
    set(config "${data}/USER/HDTRANS.CONFIG.YAML")
    file(WRITE "${config}" "dicts: ../DiCtS\ncache: off\n")
    run_discovered("猫")
    require_success()
    if(NOT output STREQUAL "야옹이")
        message(FATAL_ERROR "configured dictionary must override ${layout} default snapshot: ${output}")
    endif()
    run_discovered(--dicts "${snapshot}" "猫")
    require_success()
    if(NOT output STREQUAL "고양이")
        message(FATAL_ERROR "explicit snapshot must override ${layout} config: ${output}")
    endif()
    file(WRITE "${data}/bad.hdsnap" "damaged snapshot\n")
    run_discovered(--dicts "${data}/bad.hdsnap" "猫")
    if(status EQUAL 0)
        message(FATAL_ERROR "bad explicit snapshot must not fall back in ${layout} layout")
    endif()
    file(WRITE "${config}" "dicts: ../bad.hdsnap\ncache: off\n")
    run_discovered("猫")
    if(status EQUAL 0)
        message(FATAL_ERROR "bad configured snapshot must not fall back in ${layout} layout")
    endif()
    file(REMOVE "${config}")
    file(COPY_FILE "${snapshot}" "${data}/saved.hdsnap")
    file(WRITE "${snapshot}" "damaged snapshot\n")
    run_discovered("猫")
    if(status EQUAL 0)
        message(FATAL_ERROR "bad chosen snapshot must not fall back to ${layout} TSV")
    endif()
    file(COPY_FILE "${data}/saved.hdsnap" "${snapshot}")
    file(REMOVE "${data}/saved.hdsnap")
    file(REMOVE_RECURSE "${data}/DiCtS")
    run_discovered("猫")
    require_success()
    if(NOT output STREQUAL "고양이")
        message(FATAL_ERROR "${layout} snapshot-only layout must work without source TSV: ${output}")
    endif()
    file(REMOVE "${snapshot}")
    file(MAKE_DIRECTORY "${data}/DiCtS")
    file(WRITE "${data}/DiCtS/base.tsv" "key\tko\tpos\tid\n猫\t야옹이\tN110\t1\n")
    run_discovered("猫")
    require_success()
    if(NOT output STREQUAL "야옹이")
        message(FATAL_ERROR "${layout} default must fall back to adjacent TSV: ${output}")
    endif()
endforeach()
message(STATUS "PASS CLI options and flat/nested standalone snapshot discovery")
