cmake_minimum_required(VERSION 3.25)
# Checks that the word classes src/core names (dict::InClass, dict::ClassMembers, always with a
# literal set name; comments do not count) are the sets of classes.tsv: each named set has a doc
# line and rows, and each set of the table is named somewhere, in the sources, by an @SET of the
# construction table or by a class:SET trigger of senses.tsv (the engine checks those names when it
# reads the tables).
#   cmake -DSOURCE=<repository> -P word_classes.cmake
if(NOT DEFINED SOURCE)
    message(FATAL_ERROR "SOURCE is required")
endif()
set(table "${SOURCE}/src/core/dict/builtin/classes.tsv")
file(READ "${table}" text)
string(REPLACE "\r" "" text "\n${text}")
string(REGEX REPLACE "\n[a-z][a-z0-9.-]*\t[^\n]*" "" rest "${text}")
string(REGEX REPLACE "\n//[^\n]*" "" rest "${rest}")
string(STRIP "${rest}" rest)
if(NOT rest STREQUAL "")
    message(FATAL_ERROR "classes.tsv has rows whose set is not a lower-case name: ${rest}")
endif()
string(REGEX MATCHALL "\n//= [a-z][a-z0-9.-]*\t" docs "${text}")
list(TRANSFORM docs REPLACE "\n//= ([^\t]*)\t" "\\1")
string(REGEX MATCHALL "\n[a-z][a-z0-9.-]*\t" rows "${text}")
list(TRANSFORM rows REPLACE "\n([^\t]*)\t" "\\1")
list(REMOVE_DUPLICATES rows)

# Removes the /* */ and // comments of the C++ text in VAR; a comment opener inside a string
# literal is taken as one too, which can only hide a name, never invent one.
function(strip_comments var)
    set(text "${${var}}")
    set(out "")
    while(TRUE)
        string(FIND "${text}" "/*" block)
        string(FIND "${text}" "//" line)
        if(block EQUAL -1 AND line EQUAL -1)
            break()
        endif()
        if(line EQUAL -1 OR (NOT block EQUAL -1 AND block LESS line))
            string(SUBSTRING "${text}" 0 ${block} head)
            string(SUBSTRING "${text}" ${block} -1 text)
            string(FIND "${text}" "*/" end)
            if(end EQUAL -1)
                set(text "")
            else()
                math(EXPR end "${end} + 2")
                string(SUBSTRING "${text}" ${end} -1 text)
            endif()
        else()
            string(SUBSTRING "${text}" 0 ${line} head)
            string(SUBSTRING "${text}" ${line} -1 text)
            string(FIND "${text}" "\n" end)
            if(end EQUAL -1)
                set(text "")
            else()
                string(SUBSTRING "${text}" ${end} -1 text)
            endif()
        endif()
        string(APPEND out "${head}")
    endwhile()
    set(${var} "${out}${text}" PARENT_SCOPE)
endfunction()

file(GLOB_RECURSE sources "${SOURCE}/src/core/*.cpp" "${SOURCE}/src/core/*.h")
set(named "")
set(failures "")
foreach(path IN LISTS sources)
    file(READ "${path}" code)
    strip_comments(code)
    # The declarations take a ClassName.
    string(REGEX MATCHALL "(InClass|ClassMembers)\\([ \t\r\n]*[^ \t\r\n]" calls "${code}")
    foreach(call IN LISTS calls)
        if(NOT call MATCHES "\"$" AND NOT call MATCHES "C$")
            string(APPEND failures "${path}: a class named without a literal: ${call}\n")
        endif()
    endforeach()
    string(REGEX MATCHALL "(InClass|ClassMembers)\\([ \t\r\n]*\"[^\"]*\"" calls "${code}")
    foreach(call IN LISTS calls)
        string(REGEX REPLACE ".*\"([^\"]*)\"$" "\\1" set "${call}")
        list(APPEND named "${set}")
        if(NOT set IN_LIST docs)
            string(APPEND failures "${path}: ${set} has no doc line in classes.tsv\n")
        endif()
        if(NOT set IN_LIST rows)
            string(APPEND failures "${path}: ${set} has no rows in classes.tsv\n")
        endif()
    endforeach()
endforeach()
file(READ "${SOURCE}/src/core/dict/builtin/constructions.tsv" constructions)
# Named conditions (//: NAME <TAB> CONDITION <TAB> doc) call sets in their condition; their doc and
# other // lines are comments.
string(REGEX REPLACE "\n(//: [^\t\n]*\t[^\t\n]*)\t[^\n]*" "\n\\1" constructions "\n${constructions}")
string(REGEX REPLACE "\n//([^:\n][^\n]*)?" "" constructions "${constructions}")
string(REGEX MATCHALL "@[LR]?[a-z][a-z0-9.-]*" calls "${constructions}")
foreach(call IN LISTS calls)
    string(REGEX REPLACE "^@[LR]?" "" set "${call}")
    list(APPEND named "${set}")
endforeach()
file(READ "${SOURCE}/src/core/dict/builtin/senses.tsv" senses)
string(REGEX REPLACE "\n//[^\n]*" "" senses "\n${senses}")
string(REGEX MATCHALL "class:[a-z][a-z0-9.-]*" calls "${senses}")
foreach(call IN LISTS calls)
    string(REGEX REPLACE "^class:" "" set "${call}")
    list(APPEND named "${set}")
    if(NOT set IN_LIST rows)
        string(APPEND failures "senses.tsv: ${set} has no rows in classes.tsv\n")
    endif()
endforeach()
set(sets ${docs} ${rows})
list(REMOVE_DUPLICATES sets)
foreach(set IN LISTS sets)
    if(NOT set IN_LIST named)
        string(APPEND failures "classes.tsv: ${set} is named by no source\n")
    endif()
endforeach()
if(NOT failures STREQUAL "")
    message(FATAL_ERROR "${failures}")
endif()
list(LENGTH docs count)
message(STATUS "${count} word classes")
