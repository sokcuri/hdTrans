file(MAKE_DIRECTORY "${WORK}")
set(patterns UAqUQf UAqUQF UAqZzx)
set(expected_counts 0 1 1)
foreach(i RANGE 0 2)
    list(GET patterns ${i} pattern)
    list(GET expected_counts ${i} expected)
    set(fixture "${WORK}/${pattern}.txt")
    file(WRITE "${fixture}" "rules 1 1 0\nL 0 ||1 &&2 A+0== \"${pattern}\" D+0= \"ok\"\n")
    execute_process(COMMAND "${RULEC}" lint "${fixture}" -dicts "${DICTS}" -tsv
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${pattern}: lint failed: ${output}${error}")
    endif()
    string(REGEX MATCHALL "unknown-code" warnings "${output}")
    list(LENGTH warnings count)
    if(NOT count EQUAL expected)
        message(FATAL_ERROR "${pattern}: expected ${expected} unknown-code warnings, got ${count}: ${output}")
    endif()
    if(expected EQUAL 1)
        string(SUBSTRING "${pattern}" 3 3 unknown)
        if(NOT output MATCHES "'${unknown}' in")
            message(FATAL_ERROR "${pattern}: warning does not identify ${unknown}: ${output}")
        endif()
    endif()
    message(STATUS "${pattern}: ${count} unknown-code warnings")
endforeach()
