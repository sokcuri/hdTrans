# Sources, rules and dictionaries keep LF on every platform: the rules compiler, the layer test and
# the generated-code check read them byte for byte.
* text=auto eol=lf
# Test fixtures are checked out exactly as committed (some hold CRLF or a BOM on purpose).
tests/unit/dict/testdata/** -text
# Fuzz inputs are raw bytes, invalid UTF-8 among them: no line-end conversion and no text diff.
tests/fuzz/regressions/** binary
