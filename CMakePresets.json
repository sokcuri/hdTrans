{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "mac",
      "displayName": "macOS clang, Release (core, shared library, CLI, tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "mac-debug",
      "inherits": "mac",
      "binaryDir": "${sourceDir}/build/mac-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "mac-asan",
      "displayName": "macOS clang with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "mac",
      "binaryDir": "${sourceDir}/build/mac-asan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "HDTRANS_SANITIZE": "address,undefined" }
    },
    {
      "name": "linux",
      "displayName": "Linux, Release (core, shared library, CLI, tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "HDTRANS_SANITIZE": "address,undefined" }
    },
    {
      "name": "windows-x86",
      "displayName": "Windows MSVC x86, Release (core, DLLs, CLI, tests)",
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/windows-x86",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows MSVC x64, Release (core, DLLs, CLI, tests)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x86-ninja",
      "displayName": "Windows MSVC x86, Ninja Release (requires an x86 developer environment)",
      "inherits": "windows-x86",
      "generator": "Ninja",
      "architecture": { "value": "x86", "strategy": "external" },
      "binaryDir": "${sourceDir}/build/windows-x86-ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-x64-ninja",
      "displayName": "Windows MSVC x64, Ninja Release (requires an x64 developer environment)",
      "inherits": "windows-x64",
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "binaryDir": "${sourceDir}/build/windows-x64-ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "wasm",
      "displayName": "Emscripten (run as `emcmake cmake --preset wasm`)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "mac", "configurePreset": "mac" },
    { "name": "mac-debug", "configurePreset": "mac-debug" },
    { "name": "mac-asan", "configurePreset": "mac-asan" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "windows-x86", "configurePreset": "windows-x86", "configuration": "Release" },
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "windows-x86-ninja", "configurePreset": "windows-x86-ninja" },
    { "name": "windows-x64-ninja", "configurePreset": "windows-x64-ninja" },
    { "name": "wasm", "configurePreset": "wasm" }
  ],
  "testPresets": [
    { "name": "mac", "configurePreset": "mac", "output": { "outputOnFailure": true } },
    { "name": "mac-debug", "configurePreset": "mac-debug", "output": { "outputOnFailure": true } },
    { "name": "mac-asan", "configurePreset": "mac-asan", "output": { "outputOnFailure": true } },
    { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } },
    { "name": "linux-asan", "configurePreset": "linux-asan", "output": { "outputOnFailure": true } },
    { "name": "windows-x86", "configurePreset": "windows-x86", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-x86-ninja", "configurePreset": "windows-x86-ninja", "output": { "outputOnFailure": true } },
    { "name": "windows-x64-ninja", "configurePreset": "windows-x64-ninja", "output": { "outputOnFailure": true } }
  ]
}
