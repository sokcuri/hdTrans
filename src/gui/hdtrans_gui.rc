#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

// Controls are placed by the layout code in main.cpp; the sizes here are placeholders.
IDD_MAIN DIALOGEX 0, 0, 380, 400
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "hdTrans"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    CONTROL "", IDC_TABS, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 0, 0, 10, 10
    CONTROL "", IDC_LOG_STATUS, "Static", SS_LEFT | SS_NOTIFY, 0, 0, 10, 10
END

IDD_PAGE_TEXT DIALOGEX 0, 0, 380, 380
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT "원문", IDC_SOURCE_LABEL, 0, 0, 10, 10
    CONTROL "한꺼번에 묶어서 번역", IDC_WHOLE_DOCUMENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    EDITTEXT IDC_SOURCE, 0, 0, 10, 10, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "번역하기", IDC_TRANSLATE, 0, 0, 10, 10
    LTEXT "번역문", IDC_RESULT_LABEL, 0, 0, 10, 10
    EDITTEXT IDC_RESULT, 0, 0, 10, 10, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "출력 설정", IDC_OUTPUT_GROUP, 0, 0, 10, 10
    CONTROL "번역문만", IDC_OUTPUT_TRANSLATION, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    CONTROL "원문/번역문 출력", IDC_OUTPUT_INTERLEAVED, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 0, 0, 10, 10
    CONTROL "원문/번역문 + 개행 출력", IDC_OUTPUT_SPACED, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 0, 0, 10, 10
    CONTROL "개행만 있는 줄 번역 안함", IDC_SKIP_BLANK, "Button", BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    PUSHBUTTON "복사하기", IDC_COPY, 0, 0, 10, 10, WS_GROUP
    PUSHBUTTON "지우기", IDC_CLEAR, 0, 0, 10, 10
END

IDD_PAGE_DOCS DIALOGEX 0, 0, 380, 380
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    CONTROL "", IDC_FILES, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 0, 0, 10, 10
    PUSHBUTTON "추가...", IDC_BROWSE_INPUT, 0, 0, 10, 10
    PUSHBUTTON "빼기", IDC_REMOVE, 0, 0, 10, 10
    LTEXT "저장할 폴더", IDC_OUTPUT_LABEL, 0, 0, 10, 10
    EDITTEXT IDC_OUTPUT_PATH, 0, 0, 10, 10, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    PUSHBUTTON "찾기...", IDC_BROWSE_OUTPUT, 0, 0, 10, 10
    CONTROL "원본 파일과 같은 폴더에 저장", IDC_SAME_FOLDER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    GROUPBOX "원문 미리보기", IDC_PREVIEW_GROUP, 0, 0, 10, 10
    EDITTEXT IDC_PREVIEW, 0, 0, 10, 10, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "출력 설정", IDC_OUTPUT_GROUP, 0, 0, 10, 10
    CONTROL "번역문만", IDC_OUTPUT_TRANSLATION, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    CONTROL "원문/번역문 출력", IDC_OUTPUT_INTERLEAVED, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 0, 0, 10, 10
    CONTROL "원문/번역문 + 개행 출력", IDC_OUTPUT_SPACED, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 0, 0, 10, 10
    CONTROL "개행만 있는 줄 번역 안함", IDC_SKIP_BLANK, "Button", BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    LTEXT "", IDC_STATUS, 0, 0, 10, 10
    CONTROL "", IDC_PROGRESS, "msctls_progress32", 0, 0, 0, 10, 10
    DEFPUSHBUTTON "번역하기", IDC_TRANSLATE, 0, 0, 10, 10, WS_GROUP
    PUSHBUTTON "중단", IDC_STOP, 0, 0, 10, 10, WS_DISABLED
END

IDD_PAGE_DICTS DIALOGEX 0, 0, 380, 380
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    CONTROL "", IDC_DICTS, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | WS_BORDER | WS_TABSTOP, 0, 0, 10, 10
    PUSHBUTTON "새 사전", IDC_DICT_NEW, 0, 0, 10, 10
    PUSHBUTTON "가져오기", IDC_DICT_IMPORT, 0, 0, 10, 10
    PUSHBUTTON "내보내기", IDC_DICT_EXPORT, 0, 0, 10, 10
    PUSHBUTTON "사전 삭제", IDC_DICT_REMOVE, 0, 0, 10, 10
    CONTROL "", IDC_ENTRIES, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 0, 0, 10, 10
    EDITTEXT IDC_ENTRY_KEY, 0, 0, 10, 10, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_ENTRY_KO, 0, 0, 10, 10, ES_AUTOHSCROLL | WS_TABSTOP
    COMBOBOX IDC_ENTRY_POS, 0, 0, 10, 200, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_ENTRY_OPTIONS, 0, 0, 10, 10, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_ENTRY_NOTE, 0, 0, 10, 10, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "추가", IDC_ENTRY_ADD, 0, 0, 10, 10
    PUSHBUTTON "수정", IDC_ENTRY_EDIT, 0, 0, 10, 10
    PUSHBUTTON "삭제", IDC_ENTRY_DELETE, 0, 0, 10, 10
    PUSHBUTTON "폴더 열기", IDC_DICT_FOLDER, 0, 0, 10, 10
END

IDD_PAGE_LOGS DIALOGEX 0, 0, 380, 380
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    CONTROL "", IDC_LOG_ENTRIES, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 0, 0, 10, 10
    PUSHBUTTON "사전 확인", IDC_DICT_CHECK, 0, 0, 10, 10
    PUSHBUTTON "폴더 열기", IDC_LOG_FOLDER, 0, 0, 10, 10
    PUSHBUTTON "복사", IDC_LOG_COPY, 0, 0, 10, 10
    PUSHBUTTON "지우기", IDC_LOG_CLEAR, 0, 0, 10, 10
END

#ifdef HDTRANS_RC_MANIFEST
1 RT_MANIFEST "hdtrans_gui.manifest"
#endif
