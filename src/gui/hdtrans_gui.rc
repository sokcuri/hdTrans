#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_TRANSWIN DIALOGEX 0, 0, 360, 368
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "hdTrans 단문 번역"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT "원문", -1, 10, 10, 40, 12
    CONTROL "한꺼번에 묶어서 번역", IDC_WHOLE_DOCUMENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 225, 9, 125, 13
    EDITTEXT IDC_SOURCE, 10, 27, 340, 106, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "번역하기", IDC_TRANSLATE, 145, 140, 70, 21
    LTEXT "번역문", -1, 10, 147, 55, 12
    EDITTEXT IDC_RESULT, 10, 168, 340, 106, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "출력 설정", -1, 10, 282, 340, 48
    CONTROL "번역문만", IDC_OUTPUT_TRANSLATION, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 18, 298, 66, 13
    CONTROL "원문/번역문 출력", IDC_OUTPUT_INTERLEAVED, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 92, 298, 100, 13
    CONTROL "원문/번역문 + 개행 출력", IDC_OUTPUT_SPACED, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 205, 298, 137, 13
    CONTROL "개행만 있는 줄 번역 안함", IDC_SKIP_BLANK, "Button", BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 18, 313, 180, 13
    PUSHBUTTON "복사하기", IDC_COPY, 10, 339, 70, 21, WS_GROUP
    PUSHBUTTON "지우기", IDC_CLEAR, 87, 339, 70, 21
    PUSHBUTTON "문서 번역...", IDC_FILE, 203, 339, 77, 21
    PUSHBUTTON "닫기", IDCANCEL, 287, 339, 63, 21
END

IDD_FILE_TRANSWIN DIALOGEX 0, 0, 360, 301
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "hdTrans 문서 번역"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    GROUPBOX "파일 위치 설정", -1, 10, 8, 340, 80
    LTEXT "번역할 파일", -1, 18, 26, 65, 12
    EDITTEXT IDC_INPUT_PATH, 88, 23, 214, 16, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    PUSHBUTTON "찾기...", IDC_BROWSE_INPUT, 307, 23, 36, 17
    LTEXT "저장할 폴더", -1, 18, 49, 65, 12
    EDITTEXT IDC_OUTPUT_PATH, 88, 46, 214, 16, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    PUSHBUTTON "찾기...", IDC_BROWSE_OUTPUT, 307, 46, 36, 17
    CONTROL "원본 파일과 같은 폴더에 저장", IDC_SAME_FOLDER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 88, 67, 214, 13
    GROUPBOX "원문 미리보기", -1, 10, 95, 340, 92
    EDITTEXT IDC_PREVIEW, 18, 110, 324, 68, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "출력 설정", -1, 10, 195, 340, 48
    CONTROL "번역문만", IDC_OUTPUT_TRANSLATION, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 18, 211, 66, 13
    CONTROL "원문/번역문 출력", IDC_OUTPUT_INTERLEAVED, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 92, 211, 100, 13
    CONTROL "원문/번역문 + 개행 출력", IDC_OUTPUT_SPACED, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 205, 211, 137, 13
    CONTROL "개행만 있는 줄 번역 안함", IDC_SKIP_BLANK, "Button", BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 18, 226, 180, 13
    LTEXT "결과는 원본 이름_번역.txt에 UTF-8 BOM으로 저장합니다.", IDC_STATUS, 10, 250, 340, 16
    DEFPUSHBUTTON "번역하기", IDC_TRANSLATE, 203, 273, 70, 21, WS_GROUP
    PUSHBUTTON "닫기", IDCANCEL, 280, 273, 70, 21
END

IDD_FILE_TRANSWIN_PROG DIALOGEX 0, 0, 280, 98
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "문서 번역 진행"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT "문서를 읽고 있습니다.", IDC_STATUS, 10, 10, 260, 28
    CONTROL "", IDC_PROGRESS, "msctls_progress32", PBS_MARQUEE, 10, 42, 260, 14
    PUSHBUTTON "중단", IDC_STOP, 105, 70, 70, 21
END

#ifdef HDTRANS_RC_MANIFEST
1 RT_MANIFEST "hdtrans_gui.manifest"
#endif
