{
  "name": "hdtrans",
  "version": "0.1.1",
  "description": "Japanese to Korean translation with a bundled WebAssembly engine and dictionary",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt",
    "README.md"
  ],
  "bin": {
    "hdtrans": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sokcuri/hdTrans.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/sokcuri/hdTrans/tree/develop/npm",
  "keywords": [
    "japanese",
    "korean",
    "translation",
    "wasm"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "node ../tools/package-npm.mjs",
    "prepack": "node check-pack.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
